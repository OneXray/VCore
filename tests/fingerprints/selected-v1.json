{
  "scope": "selected-v1",
  "kind": "acceptance-declarations-not-results",
  "schema_version": 1,
  "public_values": [
    "none",
    "chrome",
    "chrome120",
    "firefox",
    "firefox120",
    "safari",
    "safari16"
  ],
  "templates": {
    "chrome": "Chrome133",
    "chrome120": "Chrome120",
    "firefox": "Firefox120",
    "firefox120": "Firefox120",
    "safari": "Safari16.0",
    "safari16": "Safari16.0"
  },
  "minimum_tls": "1.2",
  "reference_fixture": "mihomo-selected-v1.json",
  "execution_rules": [
    "repository names are logical ownership, never inferred sibling paths",
    "run in the specified repository or pass an explicit checkout to a future orchestrator",
    "planned_entrypoint means not implemented yet, never PASS",
    "a command selecting zero tests is NOT RUN, not PASS",
    "compile-only, reference capture, library handshake and VCore business evidence stay separate",
    "all server-side network roles must run in owned containers",
    "each fresh-run is distinct; partial runs cannot sign off a full stage"
  ],
  "later_required_coverage": {
    "CF2": [
      "ML-KEM real selection, not X25519 fallback only"
    ],
    "CF3": [
      "bounded Brotli/Zlib appropriate to each template",
      "legacy TLS floor",
      "selectable algorithm coverage"
    ],
    "CF4": [
      "firefox120 and safari16 each public business case",
      "none does not turn off authentication",
      "all negative REALITY cases",
      "independent feature builds"
    ],
    "CF5": [
      "HTTPUpgrade and fast-open, HTTP/legacy H2 where applicable",
      "XHTTP main/download heterogeneous profiles, inheritance and clearing",
      "H3 clearing regression",
      "20 public lifecycle and 20 owned-resource rounds per gRPC TLS and Vision REALITY group",
      "production Debug/Release, fmt, Clippy, scripts, C header",
      "publishability and standalone checkout"
    ]
  },
  "gates": [
    {
      "id": "CF0-REFERENCE",
      "stage": "CF0",
      "repository": "VCore",
      "required": true,
      "timeout_seconds": 900,
      "command": [
        "uv",
        "run",
        "--project",
        "scripts",
        "--locked",
        "python",
        "-m",
        "vcore_scripts.protocol_fingerprint_reference",
        "--run-dir",
        "{fresh-run}"
      ],
      "assertions": [
        "all 116 listed reference cases",
        "all servers and observers isolated",
        "source unchanged",
        "owned containers cleaned"
      ]
    },
    {
      "id": "CF0-RAW-CHECK",
      "stage": "CF0",
      "repository": "VCore",
      "required": true,
      "timeout_seconds": 900,
      "command": [
        "uv",
        "run",
        "--project",
        "scripts",
        "--locked",
        "python",
        "-m",
        "vcore_scripts.protocol_fingerprint_reference",
        "--check-run",
        "{reference-run}"
      ],
      "assertions": [
        "raw records match ClientHello and parsed evidence",
        "fixed order or source-defined Chrome shuffle",
        "source-defined GREASE/ECH/padding variants",
        "not a proxy interoperability result"
      ]
    },
    {
      "id": "CF0-OFFLINE",
      "stage": "CF0",
      "repository": "VCore",
      "required": true,
      "timeout_seconds": 900,
      "command": [
        "uv",
        "run",
        "--project",
        "scripts",
        "--locked",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests"
      ],
      "assertions": [
        "bounded parsing",
        "corruption detection",
        "invalid selections before IO",
        "CLI help without network"
      ]
    },
