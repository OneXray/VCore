{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": {{PORT}},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "b831381d-6324-4d53-ad4f-8cda48b30811"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "xhttpSettings": {
          "path": "/onev",
          "mode": "packet-up"
        },
        "tlsSettings": {
          "alpn": [
            "h2"
          ],
          "certificates": [
            {
              "certificateFile": "{{CERT_FILE}}",
              "keyFile": "{{KEY_FILE}}"
            }
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow"
          }
        ]
      }
    }
  ]
}
